# OhMyDocAgent 生产环境变量（复制为 .env 并填写；严禁提交真实密钥）
# 生成密钥：openssl rand -hex 32

# ---- 基础 ----
NODE_ENV=production

# ---- PostgreSQL ----
DB_HOST=postgres
DB_PORT=5432
DB_USER=ohmydocagent
DB_PASSWORD=请修改为强密码
DB_NAME=ohmydocagent

# ---- Redis（compose 内网）----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Neo4j ----
NEO4J_PASSWORD=请修改为强密码

# ---- 安全密钥（必须强随机）----
JWT_SECRET=openssl rand -hex 32 生成
ENCRYPTION_KEY=openssl rand -hex 32 生成（用于模型 API Key 加密）

# ---- 初始化安全（Task 0.5 登记项）----
# 设置后 POST /auth/init 需带 X-Init-Token 头，防公网部署被抢先初始化
INIT_TOKEN=

# ---- MinIO 对象存储（上传文件保存）----
STORAGE_BACKEND=minio
MINIO_ACCESS_KEY=ohmydocagent
MINIO_SECRET_KEY=请修改为强密码
MINIO_BUCKET=ohmydocagent

# ---- 可选：真实解析服务（gRPC，见 parser/README.md）----
# PARSER_URL=

# ---- 不应在生产使用（开发测试模型，见 .env）----
# OHMYDOCAGENT_TEST_CHAT_* / OHMYDOCAGENT_TEST_VLM_* / OHMYDOCAGENT_TEST_EMBEDDING_* / OHMYDOCAGENT_TEST_RERANK_*

# ---- Langfuse 观测（评测链路，可选；生产默认关闭） ----
# 启用：docker compose --profile evaluation up -d langfuse langfuse-db
# 后端接入：LANGFUSE_ENABLED=true 并指向 langfuse 服务地址（同一 compose 网络
# 用 http://langfuse:3000）
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
# 在 Langfuse 控制台 Project → Settings → API Keys 创建
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 评测镜像自身配置（首次部署生成随机值）
LANGFUSE_DB_PASSWORD=langfuse-local
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
