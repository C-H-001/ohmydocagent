# 复制为 .env 后按需修改；.env 已被 gitignore，不入库
# 服务端口
PORT=3000
# PostgreSQL（本地 ohmydocagent-local compose）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ohmydocagent
DB_PASSWORD=ohmydocagent
DB_NAME=ohmydocagent
# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Neo4j（本地 ohmydocagent-local compose）
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ohmydocagent-local-secret
# JWT（开发默认，生产必须更换）
JWT_SECRET=dev-secret-change-me
# 注册默认角色：仅允许 admin（Owner 绝不能通过注册产生，误配会导致启动失败）
DEFAULT_ROLE=admin
# 邀请有效期天数：1~365，默认 7（越界配置启动即失败，避免误配永久邀请）
INVITE_TTL_DAYS=7
# 上传目录（相对 backend 目录，因脚本运行时 cwd=backend，见 src/config/configuration.ts 注释）
UPLOAD_DIR=uploads
# 存储后端：local（磁盘）| minio（对象存储）
STORAGE_BACKEND=local
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=ohmydocagent
MINIO_SECRET_KEY=ohmydocagent-local-secret
MINIO_BUCKET=ohmydocagent
# 初始化安全令牌（生产设置后 /auth/init 需带 X-Init-Token；留空不校验）
INIT_TOKEN=
# 真实解析服务（gRPC 目标，如 127.0.0.1:50051；留空用占位解析器）
PARSER_URL=
# 解析引擎（MinerU：PDF/Word/图片版式还原）
PARSER_ENGINE=mineru
# 后端自身地址（解析服务拉取签名文件 URL；compose 内 http://backend:3000）
PARSER_FILE_BASE_URL=
# TypeORM synchronize 显式开关：1 开启（仅开发），生产必须为 0/不设置并走 migration
DB_SYNC=1
# API Key 加密密钥（AES-256-GCM 派生源，min 16 字符；生产必须更换）
ENCRYPTION_KEY=dev-encryption-key-change-me
